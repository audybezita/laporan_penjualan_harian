<?php
// config/database.php.example
// Salin file ini menjadi database.php dan sesuaikan kredensial Anda.

define('DB_HOST', '127.0.0.1');
define('DB_NAME', 'donat_ns');
define('DB_USER', 'root');
define('DB_PASS', '');

define('APP_NAME', 'Donat NS');

try {
    $pdo = new PDO('mysql:host='.DB_HOST.';dbname='.DB_NAME.';charset=utf8mb4', DB_USER, DB_PASS, [
        PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    ]);
} catch (PDOException $e) {
    // Jangan tampilkan detail error di production. Tampilkan panduan troubleshooting.
    die("Koneksi database gagal. Periksa file config/database.php dan server MySQL Anda.");
}
